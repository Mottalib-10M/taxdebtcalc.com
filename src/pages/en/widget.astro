---
import PageLayout from '../../layouts/PageLayout.astro';
import { SITE_URL } from '../../data/site-config';
import { route } from '../../i18n/routes';
import { breadcrumbSchema } from '../../lib/seo';
const lang = 'en';
const code = `<iframe src="${SITE_URL}/embed/tax-debt-calculator/" title="IRS tax debt calculator 2026" width="100%" height="1100" style="border:0;max-width:1100px" loading="lazy"></iframe>`;
---
<PageLayout title="Embed the 2026 IRS tax debt calculator on your site" description="Libraries, credit counselors, legal aid clinics and personal finance teachers can embed the 2026 IRS penalty and interest calculator with one iframe line. No cookie." lang={lang} noindex={true} jsonLd={[breadcrumbSchema([{ name: 'Home', path: route('home', lang) }, { name: 'Embed the calculator', path: route('widget', lang) }])]} breadcrumbs={[{ label: 'Embed the calculator' }]} showAuthor={false}>
  <header class="mb-6">
    <h1 class="font-serif text-3xl font-bold text-navy-900 md:text-4xl">Embed the tax debt calculator</h1>
    <p class="mt-3 text-lg text-navy-700">One line of code. When the IRS publishes a new quarterly rate or changes a penalty minimum, the embedded calculator follows.</p>
  </header>
  <div class="prose prose-slate max-w-none">
    <p>Terms: keep the credit line under the calculator visible, do not alter the frame, and do not present it as tax advice or as a tool of the IRS or any government agency. The frame sets no cookie and sends us nothing about your readers. Questions: <a href={route('contact', lang)}>contact page</a>.</p>
    <h2>Late filing and late payment penalties, daily interest, balance on the payoff day</h2>
    <pre class="overflow-x-auto rounded-lg bg-navy-900 p-4 text-sm text-white"><code>{code}</code></pre>
  </div>
  <div class="mt-8 overflow-hidden rounded-xl border border-navy-200">
    <iframe src="/embed/tax-debt-calculator/" title="IRS tax debt calculator 2026" width="100%" height="1100" style="border:0" loading="lazy"></iframe>
  </div>
</PageLayout>
